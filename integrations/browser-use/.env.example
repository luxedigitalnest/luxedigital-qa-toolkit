# Copy this file to .env and set only the provider you use. Never commit .env.
# Browser Use Cloud (recommended for ChatBrowserUse):
BROWSER_USE_API_KEY=

# Alternatively, configure one supported model provider:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Optional model override for non-default provider/model selection.
BROWSER_USE_LLM_MODEL=

# LDN Sales OS safety defaults.
# Use explicit hostnames and narrow the list for each job. Do not use '*'.
BROWSER_USE_ALLOWED_DOMAINS=example.com
BROWSER_USE_MAX_STEPS=6
BROWSER_USE_DISABLE_SECURITY=false
BROWSER_USE_HEADLESS=false
BROWSER_USE_LOGGING_LEVEL=warning
