# Copy this file to .env and set only the provider you use. Never commit .env.
# Browser Use Cloud (recommended for ChatBrowserUse):
BROWSER_USE_API_KEY=

# Alternatively, configure a supported model provider:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Comma-separated hostnames. The demo intentionally defaults to example.com only.
BROWSER_USE_ALLOWED_DOMAINS=example.com
BROWSER_USE_MAX_STEPS=6
